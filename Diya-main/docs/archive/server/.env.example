# Copy to .env for local development:  cp .env.example .env

# Postgres connection string (Render / Neon / Supabase).
# Render injects this automatically when using render.yaml.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Port. Render sets this automatically; 3000 is a sane local default.
PORT=3000

# Set to "disable" ONLY for a local Postgres that has no SSL.
# Leave unset (or anything else) for hosted Postgres, which requires SSL.
# PGSSL=disable

# Admin key protecting the roster upload page (/admin) and POST /api/admin/upload.
# Pick a long random secret. If unset, the admin endpoints are refused (fail closed).
ADMIN_KEY=change-me-to-a-long-random-secret
