<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DiyaMeditation.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="DiyaMeditation.Views.MainWindow"
        Title="Diya Meditation"
        CanResize="True"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="False"
        Background="White">

    <!-- The kiosk shell hosts the current screen. For now: the Home screen. -->
    <ContentControl Name="ContentHost">
        <views:HomeView />
    </ContentControl>
</Window>
