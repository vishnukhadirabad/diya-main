<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Drop the ICU/libicu runtime dependency so the .deb installs on any Ubuntu
         release (22.04/24.04/25.04...). Fine for a simple English kiosk UI. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Extract bundled native libs (SkiaSharp, PDFium) when running the
         self-contained single-file build. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Application version. Keep in sync with build-deb.sh / SETUP.md. -->
    <Version>1.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <!-- Render the meditation report PDF inside the app. 4.1.1 uses SkiaSharp
         2.88.x, matching Avalonia (avoids a SkiaSharp major-version clash).
         PDFium natives ship for linux-x64 and linux-arm64. -->
    <PackageReference Include="PDFtoImage" Version="4.1.1" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <!-- Managed cross-platform camera capture (V4L2 on Linux). The FRS page owns
         the camera so the live preview has zero lag; frames are forwarded to the
         vendored client.py for detection. Pure managed — nothing extra to bundle. -->
    <PackageReference Include="FlashCap" Version="1.10.0" />
  </ItemGroup>

  <!-- Bundle the pipeline script next to the app (dev output + published .deb).
       Edit scripts/run1.sh and rebuild to change the pipeline. -->
  <ItemGroup>
    <Content Include="scripts\*.sh">
      <Link>scripts\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Bundle the vendored am-mock-client (git submodule) face-identify client +
       its models/config (dev output + published .deb). Services/IdentifyRunner.cs
       runs vendor/am-mock-client/client.py in its kiosk-identify mode. Only the
       runtime files are bundled (not the submodule's tests/build scripts). The
       submodule must be checked out first (see deploy/build-deb.sh). Requires the
       submodule's requirements.txt to be pip-installed on the target machine (see
       deploy/setup-kiosk.sh); it is not restored by the build. -->
  <ItemGroup>
    <Content Include="vendor\am-mock-client\client.py;vendor\am-mock-client\config.yaml;vendor\am-mock-client\requirements.txt">
      <Link>vendor\am-mock-client\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="vendor\am-mock-client\models\**">
      <Link>vendor\am-mock-client\models\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
