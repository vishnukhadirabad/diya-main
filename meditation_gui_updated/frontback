#!/bin/bash

# Get project root directory dynamically
BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

HOMING="$BASE_DIR/homing.py"
CAMERA_INTEGRATION="$BASE_DIR/termination_time.py"
VIDEO_PATH="$BASE_DIR/meditation_visualRohan/ONE_MINS.mp4"
FRONT_SCRIPT="$BASE_DIR/Front.py"
SIDE_SCRIPT="$BASE_DIR/depth/splitSide.py"
GAZE_SPLIT="$BASE_DIR/splitGaze.py"
ADJUSTMENT_SCRIPT="$BASE_DIR/depth/adjustment_test_updated.py"
ACQUISITION_SCRIPT="$BASE_DIR/acquisition"
PDF_REPORT="$BASE_DIR/t3.py"
FACE_LOGIN="$BASE_DIR/AutoDetect.py"
BLACK_BG="$BASE_DIR/black_background_1920x1080.png"

echo "AutoDetect.py..."
python3 "$FACE_LOGIN"

if [ $? -ne 0 ]; then
    echo "AutoDetect.py failed. Exiting."
    exit 1
fi

echo "termination_time.py..."
python3 "$CAMERA_INTEGRATION"

if [ $? -ne 0 ]; then
    echo "termination_time.py failed. Exiting."
    exit 1
fi

# Play the video in full screen
echo "Playing meditation video in full screen..."
mpv --fs "$VIDEO_PATH"

# Run Front.py
echo "Running Front.py..."
python3 "$FRONT_SCRIPT"

if [ $? -ne 0 ]; then
    echo "Front.py failed. Exiting."
    exit 1
fi

# Run splitSide.py
echo "Running splitSide.py..."
python3 "$SIDE_SCRIPT"

if [ $? -ne 0 ]; then
    echo "splitSide.py failed. Exiting."
    exit 1
fi

# Run splitGaze.py
echo "Running splitGaze.py..."
python3 "$GAZE_SPLIT"

if [ $? -ne 0 ]; then
    echo "splitGaze.py failed. Exiting."
    exit 1
fi

# Run adjustment script
echo "Running adjustment_test_updated.py..."
python3 "$ADJUSTMENT_SCRIPT"

if [ $? -ne 0 ]; then
    echo "adjustment_test_updated.py failed. Exiting."
    exit 1
fi

# Show black screen
feh -F "$BLACK_BG" &
BLACK_PID=$!

# Run acquisition
echo "Running acquisition..."
bash "$ACQUISITION_SCRIPT"

if [ $? -ne 0 ]; then
    echo "acquisition failed."
    kill $BLACK_PID 2>/dev/null
    exit 1
fi

# Generate PDF report
echo "Running t3.py..."
python3 "$PDF_REPORT"

if [ $? -ne 0 ]; then
    echo "t3.py failed."
    exit 1
fi

# Wait and remove black screen
sleep 6
kill $BLACK_PID 2>/dev/null

# Run homing.py
echo "Running homing.py..."
python3 "$HOMING"

if [ $? -ne 0 ]; then
    echo "homing.py failed."
    exit 1
fi

echo "All tasks completed successfully."
exit 0