import tkinter as tk

def close_window():
    root.quit()

# Create the main window
root = tk.Tk()
root.title("CCTV Layout")
root.geometry("800x600")

# Create a Frame for Left and Right sections
frame = tk.Frame(root)
frame.pack(fill=tk.BOTH, expand=True)

# Create the left section (2 parts)
left_frame = tk.Frame(frame, width=300, height=600, bg="lightblue")
left_frame.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)

# Create the right section (3 parts)
right_frame = tk.Frame(frame, width=500, height=600, bg="lightgreen")
right_frame.pack(side=tk.RIGHT, fill=tk.BOTH, expand=True)

# Add placeholders for content in left side
label1 = tk.Label(left_frame, text="Check Radar", bg="lightblue", font=("Helvetica", 12))
label1.pack(pady=10)

label2 = tk.Label(left_frame, text="Check Thermal", bg="lightblue", font=("Helvetica", 12))
label2.pack(pady=10)

# Add placeholders for content in right side
label3 = tk.Label(right_frame, text="Check Visual 1", bg="lightgreen", font=("Helvetica", 12))
label3.pack(pady=10)

label4 = tk.Label(right_frame, text="Check Visual 2", bg="lightgreen", font=("Helvetica", 12))
label4.pack(pady=10)

label5 = tk.Label(right_frame, text="Depth Start", bg="lightgreen", font=("Helvetica", 12))
label5.pack(pady=10)

# Add Close button at the bottom
close_button = tk.Button(root, text="Close", command=close_window, font=("Helvetica", 12))
close_button.pack(side=tk.BOTTOM, pady=20)

# Start the main loop
root.mainloop()





