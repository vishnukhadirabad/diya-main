#!/bin/bash
## Delete existing visual posture all file
cd /home/dadn/Desktop/meditation_gui
find . -name visual1_video.avi -delete
find . -name Gaze_output.avi -delete
find . -name Depth_output.avi -delete
find . -name output_morphed_video.mp4 -delete
find . -name cd6_write.csv -delete

# Define paths
video_path="BK_1_FIVE_MINS.mp4"           # Main video
python_script="check_similarity8.py"      # Python script to run
video_on_file_creation="5M_BLACK.mp4"         # Video to play when output.txt is created
video_on_no_file="pic2.mp4"               # Fallback video when output.txt is not created
output_file="output.txt"                  # File to monitor
capture_script="./acquisition"            # Capture script

# Start playing the main video
mpv --fullscreen "$video_path" &
video_pid=$!

# Start the Python script after a brief delay
sleep 0 && python3 "$python_script" &
python_pid=$!

output_created=false

# Monitor the Python script and main video
while ps -p "$python_pid" > /dev/null || ps -p "$video_pid" > /dev/null; do
    if [ -f "$output_file" ]; then
        echo "output.txt created, stopping the main video."
        kill "$video_pid" 2>/dev/null
        # Play pic1.mp4 if output.txt is created
        mpv --fs --length=312 "$video_on_file_creation"&
        
        # Run ./thermal_capture script simultaneously and wait for it to finish
        $capture_script
        capture_exit_code=$?
        
        # Check if the capture script executed successfully
        if [ $capture_exit_code -eq 0 ]; then
            echo "Sequence9 successfully executed"
        else
            echo "Error: acquisition script failed with exit code $capture_exit_code"
        fi
        
        output_created=true
        break
    fi

    # Check if the main video has stopped
    if ! ps -p "$video_pid" > /dev/null; then
        echo "Main video has finished playing."
        break
    fi

    sleep 1
done

# After the main video ends, check for output.txt
if [ ! -f "$output_file" ] && ! $output_created; then
    echo "output.txt not found after main video ended. Playing fallback video."
    # Play the fallback video (pic2.mp4)
    mpv --fs --length=20 "$video_on_no_file"
fi

# Clean up: Kill the Python script if still running
kill "$python_pid" 2>/dev/null

# Remove output.txt if it exists
if [ -f "$output_file" ]; then
    rm "$output_file"
    echo "output.txt has been deleted."
fi

